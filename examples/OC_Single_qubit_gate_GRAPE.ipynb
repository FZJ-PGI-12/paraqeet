{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Single spin Part 3: Single qubit gate optimisation using GRAPE"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### 1. Generate a PWC pulse shape"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "from cthree.Quantity import Quantity\n",
    "\n",
    "from cthree.signal.Envelopes import GaussEnvelope\n",
    "from cthree.signal.PWCGenerator import PWCGenerator"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "First, let's generate a piecewise constant (PWC) pulse envelope for the Gaussian pulse"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "t_final = 20e-9\n",
    "tlist = np.linspace(0, t_final, 101)\n",
    "tone = GaussEnvelope(\n",
    "    amplitude=Quantity(\n",
    "        2 * np.pi / t_final / 3, -5 * np.pi / t_final, 5 * np.pi / t_final\n",
    "    )\n",
    ")\n",
    "tone.t_final.setValue(t_final)\n",
    "gen = PWCGenerator(envelopes=[tone], tlist=tlist)\n",
    "gen.multiplyFlatTop = True"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "params = gen.getParameters()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ts = np.linspace(0, t_final, 1001)\n",
    "\n",
    "plt.plot(ts / 1e-9, tone.computeOutput(ts) / 1e6, label=\"Smooth curve\")\n",
    "plt.plot(ts / 1e-9, np.real(gen.generateSignal(ts)) / 1e6, ls=\"--\", label=\"Inphase\")\n",
    "plt.plot(\n",
    "    ts / 1e-9,\n",
    "    np.imag(gen.generateSignal(ts)) / 1e6,\n",
    "    ls=\"--\",\n",
    "    label=\"Quadrature\",\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Time [in ns]\")\n",
    "plt.ylabel(\"Amplitude [in MHz]\")\n",
    "plt.legend()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### 2. Define Hamiltonian in the rotating frame of drive"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Next, we setup the qubit system we want to control. We define the Hamiltonian in the rotating frame of drive such that the pulse oscillates slowly to apply GRAPE gradients.\n",
    "\n",
    "The Hamiltonain in the rotating frame of the drive is given by - \n",
    "$$ H(t) = \\big(\\omega_q - \\omega_d\\big) b^\\dagger b -\\frac{\\alpha}{2} (b^\\dagger)^2 b^2 + (\\epsilon(t) b + \\epsilon(t)^* b)$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from cthree.Quantity import Quantity\n",
    "from cthree.model.ClosedModel import ClosedModel\n",
    "from cthree.model.RotatingFrameDrive import RotatingFrameDrive\n",
    "from cthree.model.Transmon import Transmon\n",
    "\n",
    "\n",
    "FREQ = 7.86e9 * 2 * np.pi\n",
    "DIMS = 3\n",
    "ANHARM = -50e6 * 2 * np.pi\n",
    "offset = 5e6 * 2 * np.pi\n",
    "\n",
    "drive_freq = FREQ + offset\n",
    "qubit_freq = FREQ - drive_freq\n",
    "\n",
    "Drive = RotatingFrameDrive(gen)\n",
    "transmon = Transmon(\n",
    "    frequency=Quantity(\n",
    "        qubit_freq,\n",
    "        1.2 * qubit_freq,\n",
    "        0.8 * qubit_freq,\n",
    "        unit=\"Hz\",\n",
    "        name=\"Frequency\",\n",
    "    ),\n",
    "    anharmonicity=Quantity(ANHARM, 1.2 * ANHARM, 0.8 * ANHARM, unit=\"Hz\", name=\"Anharmonicity\"),\n",
    "    drives=[Drive],\n",
    "    dimension=DIMS,\n",
    ")\n",
    "\n",
    "model = ClosedModel(transmon)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from cthree.measurement.StateTransferFidelity import StateTransferFidelityGRAPE\n",
    "from cthree.propagation.ScipyExpmGRAPE import ScipyExpmGRAPE\n",
    "\n",
    "\n",
    "prop = ScipyExpmGRAPE(model, res=1e9)\n",
    "\n",
    "init = np.array([[1.0], [0.0], [0]])  # |0>\n",
    "target = np.array([[0.0], [1.0], [0]])  # |1>\n",
    "\n",
    "prop.setInitialState(init)\n",
    "prop.setTargetState(target)\n",
    "\n",
    "prop.useSchirmerDerivative(True)\n",
    "\n",
    "zeroone = StateTransferFidelityGRAPE(\n",
    "    propagation=prop,\n",
    "    initialState=init,\n",
    "    targetState=target,\n",
    "    times=tlist,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plotStates():\n",
    "    \"\"\"Plot the states.\"\"\"\n",
    "    ts = np.linspace(0, t_final, 1001)\n",
    "    states = prop.propagate(ts)\n",
    "    sig = gen.generateSignal(ts)\n",
    "\n",
    "    fig, ax = plt.subplots(2, figsize=(4, 4), sharex=True)\n",
    "    ax[0].plot(ts / 1e-9, np.real(sig), label=\"I\")\n",
    "    ax[0].plot(ts / 1e-9, np.imag(sig), label=\"Q\")\n",
    "    ax[0].legend(loc=1)\n",
    "    ax[0].set_ylabel(\"Field [MHz]\")\n",
    "    ax[1].plot(ts / 1e-9, np.abs(states)[:, :, 0] ** 2)\n",
    "    ax[1].set_ylabel(\"Population\")\n",
    "    ax[-1].set_xlabel(\"Time [ns]\")\n",
    "    return fig, ax\n",
    "\n",
    "\n",
    "plotStates()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "As expected, we get a partial transfer and a low fidelity."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "zeroone.measure()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "We define an optimizer and link our fidelity measure as a goal function and the parameters of the cosine tone and optimise just amplitude and frequency, as in the state transfer example."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from cthree.OptimisationMap import OptimisationMap\n",
    "from cthree.optimisers.ScipyOptimiserGradient import ScipyOptimiserGradient\n",
    "\n",
    "optmap = OptimisationMap()\n",
    "optmap.add(gen, params)\n",
    "opt = ScipyOptimiserGradient(zeroone, optimisables=optmap)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "opt.optimise()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ts = np.linspace(0, t_final, 1001)\n",
    "\n",
    "plt.plot(ts / 1e-9, np.real(gen.generateSignal(ts)) / 1e6, ls=\"--\", label=\"Inphase\")\n",
    "plt.plot(\n",
    "    ts / 1e-9,\n",
    "    np.imag(gen.generateSignal(ts)) / 1e6,\n",
    "    ls=\"--\",\n",
    "    label=\"Quadrature\",\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Time [in ns]\")\n",
    "plt.ylabel(\"Amplitude [in MHz]\")\n",
    "plt.legend()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plotStates()"
   ]
  }
 ],
